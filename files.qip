# Core
set_global_assignment -name SDC_FILE Arcade-SNK68MD.sdc
set_global_assignment -name SYSTEMVERILOG_FILE rtl/savestate/system_consts.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/snk68_ss.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/snk68_ss_ui.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/hiscore.sv
set_global_assignment -name SYSTEMVERILOG_FILE Arcade-SNK68MD.sv
set_global_assignment -name VERILOG_FILE rtl/chip_select.v
set_global_assignment -name VERILOG_FILE rtl/video_timing.v
set_global_assignment -name VERILOG_FILE rtl/mem/rom_controller.v
set_global_assignment -name VERILOG_FILE rtl/mem/tile_cache.v
set_global_assignment -name VERILOG_FILE rtl/mem/cache.v
set_global_assignment -name VHDL_FILE rtl/mem/math.vhd
set_global_assignment -name VHDL_FILE rtl/mem/segment.vhd
set_global_assignment -name VHDL_FILE rtl/mem/download_buffer.vhd
set_global_assignment -name VHDL_FILE rtl/mem/sdram.vhd
set_global_assignment -name VHDL_FILE rtl/mem/dual_port_ram.vhd

# Save states: https://github.com/MiSTer-devel/Arcade-TaitoF2_MiSTer rtl/ @ 9438df98f1ea826c5398db43587992def0124603
# (Martin Donlon, GPL-2.0), unmodified apart from a provenance header
set_global_assignment -name SYSTEMVERILOG_FILE rtl/savestate/memory_stream.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/savestate/savestates.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/savestate/ddram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/savestate/savestate_ui.sv

# Pause: JimmyStones/Pause_MiSTer v0002 (Jim Gregory, GPL-3.0), as modified in va7deo/SNK68
set_global_assignment -name VERILOG_FILE rtl/pause.v

# Motorola 68000: https://github.com/ijor/fx68k @ 0602ee4627b10f301298f2673d826cdd6baa9327 (Jorge Cwik, GPL-3.0), unmodified
set_global_assignment -name SYSTEMVERILOG_FILE rtl/modules/fx68k/fx68k.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/modules/fx68k/fx68kAlu.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/modules/fx68k/uaddrPla.sv

# Zilog Z80 (T80, Daniel Wallner, MiSTer fixes): https://github.com/MiSTer-devel/NeoGeo_MiSTer rtl/cpu/T80
# @ 90a8350c4e7fafb64067cf777b58a93bc7511fdc, unmodified
set_global_assignment -name QIP_FILE rtl/modules/T80/T80.qip

# Yamaha YM3812: https://github.com/jotego/jtopl @ f96ff3ef16311e677b8bccc429b1b8f9a4e53276 (Jose Tejada, GPL-3.0); modified: hdl/jtopl_reg_ch.v reset clears the channel feedback
set_global_assignment -name QIP_FILE rtl/modules/jtopl/target/quartus/jt26.qip

# NEC uPD7759: https://github.com/jotego/jt7759 @ 94b472c002e29798c5ac719d860f83633b825156 (Jose Tejada, GPL-3.0), unmodified
set_global_assignment -name QIP_FILE rtl/modules/jt7759/hdl/jt7759.qip
